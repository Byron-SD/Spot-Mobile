# Copy to extension.env and fill in. build_extension.py packs these into the .spx,
# so use a dedicated Spot user account for this extension, not an admin login.
BOSDYN_CLIENT_USERNAME=
BOSDYN_CLIENT_PASSWORD=

# PIN the phone must enter before it can drive. Strongly recommended.
SPOT_UI_PIN=

# Port the page is served on. Must be 21000-22000 and not 21443.
SPOT_UI_PORT=21080
